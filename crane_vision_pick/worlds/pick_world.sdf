<?xml version="1.0" ?>
<!--
  CRANE+ V2 ビジョンピック用のワールド.
  - 外部モデル（Fuel）に依存しないよう、テーブル・地面・ライトをすべて内部定義（オフラインでも起動できる）
  - テーブル上面 z = 1.015（ロボットの spawn 高さと同じ）
  - red_cube（把持対象）, blue_cube（妨害物・使わないときは画面外に退避）, tray（置き場所・固定）
  - red/blue の初期位置は collect_demos / evaluate が毎回 set_pose で上書きする
-->
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.2 0 0 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 0.99 0 0 0</pose>
          <geometry><box><size>0.8 1.0 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.99 0 0 0</pose>
          <geometry><box><size>0.8 1.0 0.05</size></box></geometry>
          <material><ambient>0.82 0.74 0.62 1</ambient><diffuse>0.82 0.74 0.62 1</diffuse></material>
        </visual>
        <visual name="leg1"><pose>0.35 0.45 0.4825 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.965</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material></visual>
        <visual name="leg2"><pose>-0.35 0.45 0.4825 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.965</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material></visual>
        <visual name="leg3"><pose>0.35 -0.45 0.4825 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.965</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material></visual>
        <visual name="leg4"><pose>-0.35 -0.45 0.4825 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.965</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 置き場所: base_link 基準 r=0.21, theta=-65deg（expert.TaskConfig と一致させること） -->
    <model name="tray">
      <static>true</static>
      <pose>0.08875 -0.19033 1.015 0 0 -1.13446</pose>
      <link name="tray_link">
        <visual name="floor">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>0.10 0.10 0.002</size></box></geometry>
          <material><ambient>0.15 0.55 0.2 1</ambient><diffuse>0.15 0.55 0.2 1</diffuse></material>
        </visual>
        <collision name="wall_px"><pose>0.0525 0 0.0075 0 0 0</pose><geometry><box><size>0.005 0.11 0.015</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>0.0525 0 0.0075 0 0 0</pose><geometry><box><size>0.005 0.11 0.015</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_nx"><pose>-0.0525 0 0.0075 0 0 0</pose><geometry><box><size>0.005 0.11 0.015</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-0.0525 0 0.0075 0 0 0</pose><geometry><box><size>0.005 0.11 0.015</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_py"><pose>0 0.0525 0.0075 0 0 0</pose><geometry><box><size>0.11 0.005 0.015</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0 0.0525 0.0075 0 0 0</pose><geometry><box><size>0.11 0.005 0.015</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_ny"><pose>0 -0.0525 0.0075 0 0 0</pose><geometry><box><size>0.11 0.005 0.015</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0 -0.0525 0.0075 0 0 0</pose><geometry><box><size>0.11 0.005 0.015</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="red_cube">
      <pose>0.22 0.05 1.043 0 0 0</pose>
      <link name="red_cube_link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>2.0 2.0 0.03 0 0 0</pose>
      <link name="blue_cube_link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.05 0.15 0.85 1</ambient><diffuse>0.05 0.15 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
